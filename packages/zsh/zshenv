# -U は配列 path への代入でしか効かないため、PATH への追加は path=(...) で書く
typeset -U path fpath

### locale ###
export LANGUAGE="ja_JP.UTF-8"
export LANG="${LANGUAGE}"
export LC_ALL="${LANGUAGE}"
export LC_CTYPE="${LANGUAGE}"

### XDG ###
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

### Homebrew ###
# `brew shellenv` の出力を展開したもの
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"
export HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX"
fpath[1,0]="$HOMEBREW_PREFIX/share/zsh/site-functions"
export FPATH
path=("$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin" $path)
export INFOPATH="$HOMEBREW_PREFIX/share/info:${INFOPATH:-}"

### zsh ###
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

### rust ###
export CARGO_HOME="$XDG_DATA_HOME"/cargo

export BUN_INSTALL="$HOME/.bun"
path=("$BUN_INSTALL/bin" $path)
[ -f "$CARGO_HOME/env" ] && . "$CARGO_HOME/env"

### mise ###
path=("$HOME/.local/share/mise/shims" $path)

# Vite+ bin (https://viteplus.dev)
[ -f "$HOME/.config/vite-plus/env" ] && . "$HOME/.config/vite-plus/env"

### Microsoft Graph ###
# rd-kanban・my__teams-thread・my__sp-place が共有する Graph のトークン
export RD_KANBAN_GRAPH_TOKEN="$XDG_CONFIG_HOME/msgraph/graph-token.json"
